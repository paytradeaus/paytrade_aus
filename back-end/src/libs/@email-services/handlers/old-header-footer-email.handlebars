<!DOCTYPE html>
<html lang='en'>

  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>email-header-footer-template</title>
    <style>
      body { font-family: Arial, sans-serif; margin: 0; padding: 20px;
      background-color: #f5f5f5; }
    </style>
  </head>

  <body>
    <table
      style='margin:0 auto;border:3px solid #121b96;'
      width='600'
      cellspacing='0'
      cellpadding='0'
      border='0'
      bgcolor='#ffffff'
      align='center'
    >
      <tbody>
        <tr>
          <td height='25'><br /></td>
        </tr>
        <tr>
          <td>
            <table
              style='margin:0 auto;'
              width='520'
              cellspacing='0'
              cellpadding='0'
              border='0'
              align='center'
            >
              <tbody>
                <tr>
                  <td>
                    <table
                      width='100%'
                      cellspacing='0'
                      cellpadding='0'
                      border='0'
                      align='center'
                    >
                      <tbody>
                        <tr>
                          <td align='center'>
                            {{! <a class="defaultMailLink" href="#m_-6014724744363609778_"> }}
                            <img
                              src='cid:{{logoCid}}'
                              style='display:block;font-size:0;border:0;'
                              alt='logo'
                              width='68'
                              border='0'
                            />
                            {{! </a>  }}
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>

        <tr>
          <td>
            {{{data.mailBody}}}
          </td>
        </tr>

        <tr>
          <td>
            <table
              style='margin:0 auto;padding:0px 15px;'
              width='600'
              cellspacing='0'
              cellpadding='0'
              border='0'
              bgcolor='#f2f2f2'
              align='center'
            >
              <tbody>
                <tr>
                  <td height='10'><br /></td>
                </tr>
                <tr>
                  <td>
                    <table
                      width='350'
                      cellspacing='0'
                      cellpadding='0'
                      border='0'
                      align='left'
                    >
                      <tbody>
                        <tr>
                          <td
                            style='color:#929292;font-size:14px;line-height:2;font-weight:400;font-family:lato,Helvetica,sans-serif;'
                            align='left'
                          >
                            <div style='line-height:1.3;'>Copyright 2024 Pay
                              Trade Limited.</div>
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='color:#929292;font-size:14px;line-height:2;font-weight:400;font-family:lato,Helvetica,sans-serif;'
                            align='left'
                          >
                            <div style='line-height:1.3;'>All rights reserved.
                              Pay Trade Limited.</div>
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='color:#929292;font-size:14px;line-height:2;font-weight:400;font-family:lato,Helvetica,sans-serif;'
                            align='left'
                          >
                            <div style='line-height:1.3;'>Red Copse, Foxcomb
                              Road,</div>
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='color:#929292;font-size:14px;line-height:2;font-weight:400;font-family:lato,Helvetica,sans-serif;'
                            align='left'
                          >
                            <div style='line-height:1.3;'>Oxford, OX1 5DG.</div>
                          </td>
                        </tr>
                        <tr>
                          <td height='10'><br /></td>
                        </tr>
                        <tr>
                          <td
                            style='font-size:14px;font-weight:400;font-family:lato,Helvetica,sans-serif;'
                            align='left'
                          >
                            <div style='line-height:1.3;'><a
                                style='color:#929292;text-decoration:none;font-weight:500;'
                                href='mailto:support@pay-trade.co.uk'
                              >support@pay-trade.co.uk</a></div>
                          </td>
                        </tr>
                        <tr>
                          <td
                            style='font-size:14px;font-weight:400;font-family:lato,Helvetica,sans-serif;'
                            align='left'
                          >
                            <div style='line-height:1.3;'>
                              <span>
                                <a
                                  style='color:#929292;text-decoration:none;'
                                  href='{{faqLink}}'
                                  target='_blank'
                                  rel='noopener noreferrer'
                                  data-ik='ik-secure'
                                >Visit FAQ</a>
                              </span>
                            </div>
                          </td>
                        </tr>
                        <tr>
                          <td height='10'><br /></td>
                        </tr>
                      </tbody>
                    </table>
                    <table
                      width='120'
                      cellspacing='0'
                      cellpadding='0'
                      border='0'
                      align='right'
                    >
                      <tbody>
                        <tr>
                          <td>
                            <table
                              style='margin:0 auto;'
                              width='120'
                              align='center'
                            >
                              <tbody>
                                <tr>
                                  <td width='30' align='center'>
                                    <a
                                      style='border-style:none!important;display:inline-block;border:0!important;'
                                      href=''
                                    >
                                      <img
                                        src='cid:{{fbCid}}'
                                        style='display:block;font-size:0;border:0;'
                                        alt=''
                                        width='30'
                                        border='0'
                                      />
                                    </a>
                                  </td>
                                  <td width='15'><br />
                                  </td>
                                  <td width='30' align='center'>
                                    <a
                                      style='border-style:none!important;display:inline-block;border:0!important;'
                                      href=''
                                    >
                                      <img
                                        src='cid:{{twitterCid}}'
                                        style='display:block;font-size:0;border:0;'
                                        alt=''
                                        width='30'
                                        border='0'
                                      />
                                    </a>
                                  </td>
                                  <td width='15'><br />
                                  </td>
                                  <td width='30' align='center'>
                                    <a
                                      style='border-style:none!important;display:inline-block;border:0!important;'
                                      href=''
                                    >
                                      <img
                                        src='cid:{{gpCid}}'
                                        style='display:block;font-size:0;border:0;'
                                        alt=''
                                        width='30'
                                        border='0'
                                      />
                                    </a>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          </td>
                        </tr>
                        <tr>
                          <td height='10'><br /></td>
                        </tr>
                      </tbody>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td height='25'><br /></td>
                </tr>
              </tbody>
            </table>
          </td>
        </tr>
      </tbody>
    </table>
  </body>

</html>