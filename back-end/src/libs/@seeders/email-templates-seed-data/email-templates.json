    "email_content": "<div style=\"font-family:Arial,Helvetica,sans-serif;color:#222;\"><h2 style=\"margin:0 0 8px;color:#0d3b66;\">AI credits top-up receipt</h2><p style=\"margin:0 0 4px;color:#555;font-size:13px;\">Receipt <strong>#{{receipt_id_short}}</strong> · {{receipt_date}}</p><p style=\"margin:16px 0 12px;\">Hi {{company_name}},</p><p style=\"margin:0 0 16px;\">Thanks for topping up your Pay Trade AI credit balance. Your payment has been processed successfully and the credits are already available in your account. A copy of this receipt is below for your records.</p><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;max-width:560px;border:1px solid #e3e7ec;border-radius:6px;overflow:hidden;\"><tr><td style=\"background:#f5f8fb;padding:10px 12px;font-size:13px;color:#445;width:55%;border-bottom:1px solid #e3e7ec;\">Credits added</td><td style=\"padding:10px 12px;font-size:13px;text-align:right;border-bottom:1px solid #e3e7ec;\">{{credits_amount}} {{currency}}</td></tr><tr><td style=\"background:#f5f8fb;padding:10px 12px;font-size:13px;color:#445;border-bottom:1px solid #e3e7ec;\">Stripe processing fee</td><td style=\"padding:10px 12px;font-size:13px;text-align:right;border-bottom:1px solid #e3e7ec;\">{{stripe_fee}} {{currency}}</td></tr><tr><td style=\"background:#0d3b66;color:#fff;padding:12px;font-size:14px;font-weight:bold;\">Total charged</td><td style=\"background:#0d3b66;color:#fff;padding:12px;font-size:14px;font-weight:bold;text-align:right;\">{{total_charged}} {{currency}}</td></tr></table><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;max-width:560px;margin-top:16px;font-size:12px;color:#555;\"><tr><td style=\"padding:4px 0;width:55%;\">Trigger</td><td style=\"padding:4px 0;text-align:right;\">{{trigger_label}}</td></tr><tr><td style=\"padding:4px 0;\">Card</td><td style=\"padding:4px 0;text-align:right;\">{{card_last4}}</td></tr><tr><td style=\"padding:4px 0;\">Stripe payment ID</td><td style=\"padding:4px 0;text-align:right;font-family:monospace;font-size:11px;\">{{stripe_payment_id}}</td></tr><tr><td style=\"padding:4px 0;\">Receipt ID</td><td style=\"padding:4px 0;text-align:right;font-family:monospace;font-size:11px;\">{{receipt_id}}</td></tr></table>{{receipt_url_block}}{{gst_disclaimer_block}}<p style=\"margin-top:20px;font-size:12px;color:#777;\">Need a hand? Reply to this email or contact <a href=\"mailto:support@paytrade.app\" style=\"color:#0d3b66;\">support@paytrade.app</a>.</p><p style=\"margin-top:8px;font-size:11px;color:#999;\">AI credits do not roll over — any unused balance is reset at the start of each calendar month per your subscription plan.</p></div>",
    "created_group": "SYSTEM",
    "updated_group": "SYSTEM"
  },
